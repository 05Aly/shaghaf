# Public by design (protected by Supabase RLS) - bundled into the client
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Server-only secrets (no VITE_ prefix) - set in Vercel Environment Variables
DRIVE_API_KEY=your_google_api_key
DRIVE_ROOT_FOLDER_ID=your_root_folder_id
